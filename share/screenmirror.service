[Unit]
Description=ScreenMirror LAN TV stream
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=3
# screenmirror-plugin-owned: fpaulcris.screenmirror

[Service]
Type=simple
ExecStart=@PLUGIN_DIR@/zig/zig-out/bin/screencast serve
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=3

[Install]
WantedBy=graphical-session.target
