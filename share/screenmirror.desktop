[Desktop Entry]
Type=Application
Name=Screen Cast
GenericName=TV screen cast
Comment=Cast this desktop to a TV browser on the same Wi-Fi. This is a browser address, so it will not show up in the TV's screen-cast menu.
Exec=screencast start
Icon=screencast
Terminal=false
Categories=AudioVideo;Utility;
Keywords=tv;mirror;cast;screencast;wifi;browser;
StartupNotify=true
StartupWMClass=screenmirror
X-ScreenMirror-Plugin=fpaulcris.screenmirror
Actions=start;stop;

[Desktop Action start]
Name=Start in background
Exec=screencast start

[Desktop Action stop]
Name=Stop Screen Cast
Exec=screencast stop
