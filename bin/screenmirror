#!/usr/bin/env bash
# ScreenMirror — stream this desktop to a TV browser on the LAN.
set -euo pipefail

UNIT="screenmirror.service"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  RUNTIME="${XDG_RUNTIME_DIR}/screenmirror"
else
  RUNTIME="${HOME}/.cache/screenmirror"
fi
PRIMARY_PORT="${MIRROR_PORTS:-8080}"
PRIMARY_PORT="${PRIMARY_PORT%%,*}"
SAME_WIFI="The TV or phone has to be on the same Wi-Fi as this computer."
BROWSER_NOTE="This is a browser address, so it will not show up in the TV's screen-cast menu."

usage() {
  cat <<EOF
Screen Cast — cast this screen to a smart TV browser over Wi-Fi.
The command is screencast.

Usage:
  screencast            Start in the background. The panel is on the bar.
  screencast open       Start in the background. Does not open a window.
  screencast start      Start in the background
  screencast stop       Stop
  screencast status     Running or not, plus the URL
  screencast status --json
                          One JSON object: state, url, detail
  screencast url        Print the TV address
  screencast copy       Copy the TV address to the clipboard
  screencast desktops --json
                          Desktops that can be cast
  screencast cast --json
                          Chosen desktop and resolution
  screencast cast --workspace follow
                          Follow this laptop's screen
  screencast cast --workspace 2
                          Cast desktop 2 from its own virtual screen
  screencast cast --size auto
  screencast cast --size 1920x1080
                          1280x720, 1920x1080, 2560x1440, or 3840x2160
  screencast qr         Write a QR code for the address and print its path
  screencast receivers --json
                          AirPlay, Chromecast, and Miracast devices on this Wi-Fi
  screencast help

${SAME_WIFI}
${BROWSER_NOTE}
EOF
}

lan_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}'
}

predicted_url() {
  local ip
  ip="$(lan_ip)"
  echo "http://${ip:-127.0.0.1}:${PRIMARY_PORT}/"
}

is_active() {
  systemctl --user is-active --quiet "$UNIT"
}

wait_for_url() {
  local i
  for i in $(seq 1 40); do
    if [[ -s "$RUNTIME/url" ]]; then
      return 0
    fi
    sleep 0.15
  done
  return 1
}

current_url() {
  if [[ -s "$RUNTIME/url" ]]; then
    tr -d '\n' <"$RUNTIME/url"
    return 0
  fi
  predicted_url
}

copy_url() {
  local url
  url="$(current_url)"
  if command -v wl-copy >/dev/null; then
    printf '%s' "$url" | wl-copy
  fi
  printf '%s\n' "$url"
}

cmd_start() {
  systemctl --user start "$UNIT"
  if ! wait_for_url; then
    echo "Screen Cast started, but the URL file is not ready yet." >&2
    echo "Check: systemctl --user status $UNIT" >&2
    return 1
  fi
  local url
  url="$(tr -d '\n' <"$RUNTIME/url")"
  command -v wl-copy >/dev/null && printf '%s' "$url" | wl-copy || true
  if command -v omarchy-notification-send >/dev/null; then
    omarchy-notification-send --app-name "Screen Cast" -g $'\uf03d' -t 12000 \
      "Screen Cast is live" "On the TV browser: $url"$'\n'"${SAME_WIFI} ${BROWSER_NOTE}"
  fi
  echo "$url"
}

cmd_stop() {
  systemctl --user stop "$UNIT" 2>/dev/null || true
  echo "Screen Cast stopped."
}

cmd_status_json() {
  MIRROR_RUNTIME="$RUNTIME" MIRROR_PREDICTED="$(predicted_url)" python3 - <<'PY'
import json, os, shutil, subprocess

runtime = os.environ.get("MIRROR_RUNTIME", "")
predicted = os.environ.get("MIRROR_PREDICTED", "")
status_path = os.path.join(runtime, "status.json")
url_path = os.path.join(runtime, "url")

def ok(args):
    try:
        return subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except Exception:
        return False

active = ok(["systemctl", "--user", "is-active", "--quiet", "screenmirror.service"])
failed = ok(["systemctl", "--user", "is-failed", "--quiet", "screenmirror.service"])
data = {}
try:
    with open(status_path, encoding="utf-8") as fh:
        loaded = json.load(fh)
        if isinstance(loaded, dict):
            data = loaded
except Exception:
    data = {}
url = ""
try:
    with open(url_path, encoding="utf-8") as fh:
        url = fh.read().strip()
except Exception:
    url = ""
if not url:
    url = str(data.get("primary") or predicted or "")
if failed and not active:
    state = "failed"
elif active and data.get("ready") is True and data.get("listening") is True:
    state = "live"
elif active:
    state = "starting"
else:
    state = "stopped"
cast = {}
try:
    with open(os.path.expanduser("~/.config/screenmirror/cast.json"), encoding="utf-8") as fh:
        loaded = json.load(fh)
        if isinstance(loaded, dict):
            cast = loaded
except Exception:
    cast = {}
def wants_follow(status, saved):
    if status:
        if status.get("follow") is True:
            return True
        if status.get("follow") is False:
            return False
        if status.get("virtual") is True or status.get("workspace"):
            return False
    if saved.get("follow") is True:
        return True
    if saved.get("workspace") not in (None, "", 0):
        return False
    return True

follow = wants_follow(data, cast)
workspace = data.get("workspace") if data.get("workspace") not in (None, "", 0) else cast.get("workspace") or ""
if follow:
    workspace = "follow"
width = data.get("width") or cast.get("width") or 1920
height = data.get("height") or cast.get("height") or 1080
virtual = data.get("virtual") is True
detail = ""
if state == "failed":
    if shutil.which("wf-recorder") is None:
        detail = "wf-recorder is not installed."
    else:
        detail = "The stream stopped."
elif follow:
    detail = f"Following this screen, {width}×{height}."
elif workspace:
    place = "a virtual screen" if virtual else "this screen"
    detail = f"Desktop {workspace} on {place}, {width}×{height}."
print(json.dumps({"state": state, "url": url, "detail": detail, "workspace": str(workspace), "follow": follow, "size": f"{width}x{height}"}))
PY
}

cmd_desktops() {
  python3 - <<'PY'
import json, subprocess
try:
    monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"], text=True))
except Exception:
    monitors = []
laptop = next((mon for mon in monitors if str(mon.get("name", "")).startswith("eDP")), monitors[0] if monitors else {})
active = str(int((laptop.get("activeWorkspace") or {}).get("id") or 1))
ids = list(range(1, 6))
try:
    workspaces = json.loads(subprocess.check_output(["hyprctl", "workspaces", "-j"], text=True))
except Exception:
    workspaces = []
for item in workspaces:
    try:
        ident = int(item.get("id") or 0)
    except (TypeError, ValueError):
        continue
    if 1 <= ident <= 10 and ident not in ids:
        ids.append(ident)
ids.sort()
options = [{"value": "follow", "label": "Follow Screen"}]
for ident in ids:
    options.append({"value": str(ident), "label": f"Desktop {ident}"})
print(json.dumps({"active": active, "desktops": options}))
PY
}

cmd_cast() {
  local show_json=0 workspace="" size=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) show_json=1 ;;
      --workspace)
        shift
        workspace="${1:-}"
        ;;
      --size)
        shift
        size="${1:-}"
        ;;
      *)
        echo "Unknown option: $1" >&2
        return 1
        ;;
    esac
    shift
  done
  CAST_WORKSPACE="$workspace" CAST_SIZE="$size" CAST_JSON="$show_json" \
    CAST_FILE="${HOME}/.config/screenmirror/cast.json" python3 - <<'PY'
import json, os, subprocess, sys
path = os.environ["CAST_FILE"]
workspace = os.environ.get("CAST_WORKSPACE", "")
size = os.environ.get("CAST_SIZE", "")
allowed = {"1280x720": (1280, 720), "1920x1080": (1920, 1080), "2560x1440": (2560, 1440), "3840x2160": (3840, 2160)}
current = {"width": 1920, "height": 1080, "auto": True}
try:
    with open(path, encoding="utf-8") as fh:
        loaded = json.load(fh)
        if isinstance(loaded, dict):
            current.update({k: loaded[k] for k in ("workspace", "width", "height", "follow", "auto") if k in loaded})
except Exception:
    pass
if workspace:
    if workspace == "follow":
        current["follow"] = True
        current.pop("workspace", None)
    else:
        try:
            chosen = int(workspace)
        except ValueError:
            chosen = 0
        if not 1 <= chosen <= 10:
            print("Desktop must be from 1 to 10, or follow.", file=sys.stderr)
            sys.exit(1)
        current["workspace"] = chosen
        current["follow"] = False
if size:
    if size == "auto":
        current["auto"] = True
    elif size not in allowed:
        print("Resolution must be auto, 1280x720, 1920x1080, 2560x1440, or 3840x2160.", file=sys.stderr)
        sys.exit(1)
    else:
        current["auto"] = False
        current["width"], current["height"] = allowed[size]
if workspace or size:
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    temporary = path + ".tmp"
    with open(temporary, "w", encoding="utf-8") as fh:
        json.dump(current, fh)
        fh.write("\n")
    os.replace(temporary, path)
if current.get("follow") is True or current.get("workspace") in (None, "", 0):
    shown = "follow"
    following = True
else:
    shown = current.get("workspace")
    following = False
auto = current.get("auto", True) is not False
shown_size = "auto" if auto else f'{current["width"]}x{current["height"]}'
print(json.dumps({"workspace": str(shown), "follow": following, "auto": auto, "size": shown_size}))
PY
}

cmd_qr() {
  local url
  url="$(current_url)"
  if ! command -v qrencode >/dev/null; then
    echo "qrencode is not installed." >&2
    return 1
  fi
  mkdir -p -m 700 "$RUNTIME"
  qrencode -t PNG -o "$RUNTIME/qr.png" -s 8 -m 2 -- "$url"
  printf '%s\n' "$RUNTIME/qr.png"
}

cmd_status() {
  if [[ "${1:-}" == "--json" ]]; then
    cmd_status_json
    return 0
  fi
  if is_active; then
    echo "running"
    [[ -s "$RUNTIME/url" ]] && echo "url $(tr -d '\n' <"$RUNTIME/url")"
    [[ -f "$RUNTIME/status.json" ]] && cat "$RUNTIME/status.json"
    return 0
  fi
  echo "stopped"
  return 1
}

cmd_url() {
  current_url
  echo
}

# One status window. flock stays the parent of that window, so the lock
# lives until the window closes. A second open focuses the existing window
# and does not start another controller, so it cannot stop the stream.
screenmirror_address() {
  command -v hyprctl >/dev/null || return 1
  hyprctl clients -j 2>/dev/null | python3 -c '
import json, sys
try:
    clients = json.load(sys.stdin)
except Exception:
    clients = []
for client in clients:
    klass = str(client.get("class") or client.get("initialClass") or "")
    title = str(client.get("title") or client.get("initialTitle") or "")
    if not client.get("address"):
        continue
    if klass == "screenmirror" or (klass == "foot" and (title == "Screen Cast" or title == "ScreenMirror")):
        print(client["address"])
        break
'
}

focus_window() {
  local addr
  addr="$(screenmirror_address || true)"
  [[ -n "$addr" ]] || return 1
  # Omarchy turns dispatch into Lua. A failed focus still means the window
  # is open, so the caller must not start a second one.
  hyprctl dispatch "hl.dsp.focus({ window = \"address:${addr}\" })" >/dev/null 2>&1 || true
  return 0
}

wait_for_window() {
  local i
  for i in $(seq 1 25); do
    if focus_window; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

# Hold the lock in this process only. The fd is not inheritable, so a
# clipboard helper that stays running cannot keep the window locked.
run_locked() {
  SCREENMIRROR_LOCK="$RUNTIME/ui.lock" python3 - "$@" <<'PY'
import fcntl, os, subprocess, sys
fd = os.open(os.environ["SCREENMIRROR_LOCK"], os.O_RDWR | os.O_CREAT, 0o600)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit(2)
os.set_inheritable(fd, False)
raise SystemExit(subprocess.call(sys.argv[1:]))
PY
}

close_ui_windows() {
  python3 - <<'PY'
import json, subprocess
try:
    clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"], text=True))
except Exception:
    clients = []
for client in clients:
    title = str(client.get("title") or "")
    klass = str(client.get("class") or "")
    initial = str(client.get("initialClass") or "")
    if title != "Screen Cast" and klass != "screenmirror" and initial != "screenmirror":
        continue
    address = str(client.get("address") or "")
    if not address:
        continue
    selector = address if address.startswith("address:") else f"address:{address}"
    subprocess.run(
        ["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "{selector}" }})'],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
PY
}

cmd_open() {
  close_ui_windows
  if ! is_active; then
    cmd_start
  fi
}

cmd_ui() {
  mkdir -p -m 700 "$RUNTIME"
  if [[ "${SCREENMIRROR_LOCK_HELD:-}" != 1 ]]; then
    export SCREENMIRROR_LOCK_HELD=1
    local status=0
    run_locked "$0" ui || status=$?
    if [[ "$status" -eq 2 ]]; then
      focus_window || true
      echo "Screen Cast is already open."
      exit 0
    fi
    exit "$status"
  fi
  if ! is_active; then
    cmd_start >/dev/null
  fi
  wait_for_url || true
  local url ip
  url="$(current_url)"
  ip="$(lan_ip)"

  clear
  echo
  echo "  Screen Cast"
  echo "  ------------"
  echo
  echo "  On the TV:"
  echo "    1. Open the internet browser"
  echo "    2. Go to this address:"
  echo
  echo "       $url"
  echo
  echo "  ${SAME_WIFI}"
  echo "  ${BROWSER_NOTE}"
  echo
  echo "  Fallback:  http://${ip}:${PRIMARY_PORT}/"
  echo "             http://${ip}:8000/"
  echo
  if command -v qrencode >/dev/null; then
    qrencode -t ansiutf8 "$url" || true
    echo
  fi
  echo "  URL copied to the clipboard."
  echo "  Press q to stop and quit.  Ctrl-C also stops."
  echo

  cleanup() {
    cmd_stop >/dev/null || true
  }
  trap cleanup EXIT INT TERM

  while true; do
    if ! is_active; then
      sleep 2
      if ! is_active; then
        echo "Stream ended."
        break
      fi
    fi
    if read -rsn1 -t 1 key; then
      case "$key" in
        q|Q) break ;;
      esac
    fi
  done
}

cmd_receivers() {
  python3 - <<'PY'
import json, re, subprocess, sys

wanted = {
    "_airplay._tcp": "AirPlay",
    "_googlecast._tcp": "Chromecast",
    "_display._tcp": "Miracast",
}
audio_models = (
    "nest mini",
    "nest audio",
    "google nest mini",
    "chromecast audio",
    "homepod",
    "audioaccessory",
    "google home",
    "nest hub max",
)
# Nest Hub has a screen. "google home" above is the speaker; keep hubs as video.
video_exceptions = ("nest hub", "google home hub")

def unescape(text):
    def repl(match):
        return chr(int(match.group(1), 8))
    return re.sub(r"\\([0-7]{3})", repl, text)

def txt_map(raw):
    found = {}
    for part in re.findall(r'"([^"]*)"', raw):
        if "=" in part:
            key, value = part.split("=", 1)
            found[key] = unescape(value)
    return found

def is_speaker(protocol, model):
    folded = model.lower()
    if protocol == "Miracast":
        return False
    if any(name in folded for name in video_exceptions) and "nest hub max" not in folded:
        return False
    if "nest hub max" in folded:
        return False
    if protocol == "AirPlay" and ("audioaccessory" in folded or "homepod" in folded):
        return True
    if protocol == "Chromecast":
        if "group" in folded:
            return True
        if any(name in folded for name in audio_models):
            if "hub" in folded:
                return False
            return True
    return False

try:
    proc = subprocess.run(
        ["avahi-browse", "-arpkt"],
        text=True,
        capture_output=True,
        timeout=6,
    )
    text = proc.stdout or ""
except FileNotFoundError:
    json.dump({"receivers": [], "error": "Install avahi to look for receivers."}, sys.stdout)
    sys.stdout.write("\n")
    raise SystemExit(0)
except subprocess.TimeoutExpired as exc:
    text = exc.stdout or ""
    if isinstance(text, bytes):
        text = text.decode("utf-8", "replace")

found = {}
for line in text.splitlines():
    if not line.startswith("="):
        continue
    parts = line.split(";")
    if len(parts) < 9:
        continue
    protocol = wanted.get(parts[4])
    if protocol is None or parts[2] != "IPv4":
        continue
    address = parts[7]
    if ":" in address:
        continue
    fields = txt_map(";".join(parts[9:]))
    model = fields.get("md") or fields.get("model") or fields.get("am") or ""
    name = fields.get("fn") or fields.get("name") or unescape(parts[3])
    speaker = is_speaker(protocol, model or name)
    item = {
        "id": protocol + ":" + address,
        "name": name,
        "protocol": protocol,
        "address": address,
        "model": model,
        "video": not speaker,
        "note": "This is a speaker, so it cannot show the screen." if speaker else "",
    }
    found[item["id"]] = item

receivers = sorted(found.values(), key=lambda item: (not item["video"], item["name"].lower()))
json.dump({"receivers": receivers}, sys.stdout)
sys.stdout.write("\n")
PY
}

cmd="${1:-open}"
case "$cmd" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  status) cmd_status "${2:-}" ;;
  url) cmd_url ;;
  copy) copy_url ;;
  open) cmd_open ;;
  ui) cmd_ui ;;
  desktops) cmd_desktops ;;
  cast) cmd_cast "${@:2}" ;;
  qr) cmd_qr ;;
  receivers) cmd_receivers ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
